// .gitignore
node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# macOS
.DS_Store

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local.env

# Native build folders (Prebuild/CNG)
/android
/ios

# Module build artifacts
modules/*/android/build/
modules/*/ios/build/
