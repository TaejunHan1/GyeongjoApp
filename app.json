{
  "expo": {
    "name": "경조사 관리",
    "slug": "gyeongjoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeongdam.gyeongjoapp",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "gyeongjoapp",
            "CFBundleURLSchemes": [
              "gyeongjoapp"
            ]
          },
          {
            "CFBundleURLName": "gyeongjoapp",
            "CFBundleURLSchemes": [
              "gyeongjoapp"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jeongdam.gyeongjoapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gyeongjoapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/jeongdamlogo.png",
      "color": "#191F28",
      "iosDisplayInForeground": true
    },
    "scheme": "gyeongjoapp",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/jeongdamlogo.png",
          "color": "#191F28"
        }
      ],
      "./plugins/withWorkManagerFix"
    ],
    "extra": {
      "revenueCatIosApiKey": "test_pEzVqknUVJkMMaLuILgfqLVszLc",
      "revenueCatAndroidApiKey": "test_pEzVqknUVJkMMaLuILgfqLVszLc",
      "eas": {
        "projectId": "6e007e44-78af-48b5-b36e-ab75a54ab3fa"
      }
    }
  }
}
